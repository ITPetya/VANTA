# VANTA Konfiguration
# Diese Datei nach .env kopieren und echte Werte eintragen.
# Die .env niemals einchecken.

# Allgemein
VANTA_TIMEZONE=Europe/Berlin
VANTA_USER_ID=1

# Datenbank
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=vanta
POSTGRES_USER=vanta
POSTGRES_PASSWORD=
# Nur für Tests: leere Wegwerf-Datenbank (Test löscht das Schema public!), z. B.
# VANTA_TEST_DATABASE_URL=postgresql+psycopg://user:passwort@localhost:5432/vanta_test
VANTA_TEST_DATABASE_URL=

# Verschlüsselung (Pfade zu Schlüsseldateien, nicht die Schlüssel selbst)
VANTA_KEY_LEVEL2_PATH=/run/secrets/vanta_level2.key
VANTA_KEY_LEVEL3_PATH=/run/secrets/vanta_level3.key

# Sprachmodell
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_REALTIME=
LLM_MODEL_BATCH=

# Mail
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_USER=
MAIL_PASSWORD=

# Kalender
CALDAV_URL=
CALDAV_USER=
CALDAV_PASSWORD=

# Apple Push
APNS_KEY_PATH=/run/secrets/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# Zustellung
PUSH_BUDGET_PER_DAY=3
QUIET_HOURS_START=22:30
QUIET_HOURS_END=06:30

# Geräte-Authentifizierung (siehe docs/SIGNATUR.md)
# Erlaubte Abweichung des Zeitstempels einer Anfrage von der Serveruhr, in Sekunden
VANTA_AUTH_TOLERANCE_SECONDS=60
# Gültigkeit eines einmaligen Registrierungscodes, in Sekunden
VANTA_REGISTRATION_CODE_TTL_SECONDS=600

# Überwachung
# Datei, die der Backup-Job nach jedem erfolgreichen Backup berührt (Änderungszeit = letztes Backup)
VANTA_BACKUP_MARKER_PATH=
# Backup (siehe docs/BACKUP.md)
# Zielordner der verschlüsselten Backups
VANTA_BACKUP_DIR=
# Passphrase-Datei für die Backup-Verschlüsselung, getrennt von den Backups aufbewahren
VANTA_BACKUP_KEY_PATH=
# Anzahl der aufbewahrten Backups (die neuesten)
VANTA_BACKUP_KEEP=14
# Optional: eigener Dump-Befehl, leer = pg_dump mit den POSTGRES_-Einstellungen
VANTA_BACKUP_DUMP_COMMAND=
# Uptime Kuma Push-URLs, pro Quelle (leer = kein Push)
KUMA_PUSH_INGEST_HEALTH=
KUMA_PUSH_INGEST_MAIL=
KUMA_PUSH_INGEST_CALENDAR=
KUMA_PUSH_INGEST_NEWS=
KUMA_PUSH_DELIVERY=
